; Script generated by the Inno Setup Script Wizard.
; SEE THE DOCUMENTATION FOR DETAILS ON CREATING INNO SETUP SCRIPT FILES!

#define AppName "Codex Trainer"
#define AppVersion "2.0"
#define AppPublisher "Codex Team"
#define AppURL "https://github.com/zsxbb/codex-aqwi"

[Setup]
; NOTE: The value of AppId uniquely identifies this application. Do not use the same AppId value in installers for other applications.
; (To generate a new GUID, click Tools | Generate GUID inside the IDE.)
AppId={{D3F9F5A6-D9D0-4B17-8D52-6C9A20F8E3B6}
AppName={#AppName}
AppVersion={#AppVersion}
AppPublisher={#AppPublisher}
AppPublisherURL={#AppURL}
AppSupportURL={#AppURL}
AppUpdatesURL={#AppURL}
DefaultDirName={reg:HKCU\Software\Valve\Steam,SteamPath|C:\Program Files (x86)\Steam}\steamapps\common\AdventureQuest Worlds Unity Playtest\AdventureQuest Worlds Infinity_Data\Managed
DirExistsWarning=no
AppendDefaultDirName=no
DisableProgramGroupPage=yes
LicenseFile=Publish\README.txt
; Remove the comment below if you want to run in non-administrative install mode (install for current user only.)
; PrivilegesRequired=lowest
PrivilegesRequired=admin
OutputDir=Publish
OutputBaseFilename=CodexSetup
Compression=lzma
SolidCompression=yes
WizardStyle=modern
DisableWelcomePage=no
DisableDirPage=no
DisableReadyPage=no
DisableFinishedPage=no
SetupIconFile=Publish\setup.ico
UninstallDisplayIcon={app}\README.txt

[Languages]
Name: "english"; MessagesFile: "compiler:Default.isl"

[Files]
Source: "AutoAttackTrainer\bin\Release\netstandard2.1\AutoAttackTrainer.dll"; DestDir: "{app}"; Flags: ignoreversion
Source: "AutoAttackTrainer\bin\Release\netstandard2.1\0Harmony.dll"; DestDir: "{app}"; Flags: ignoreversion
Source: "AutoAttackTrainer\bin\Release\netstandard2.1\Concentus.dll"; DestDir: "{app}"; Flags: ignoreversion
Source: "AutoAttackTrainer\bin\Release\netstandard2.1\System.Memory.dll"; DestDir: "{app}"; Flags: ignoreversion
Source: "AutoAttackTrainer\bin\Release\netstandard2.1\System.Buffers.dll"; DestDir: "{app}"; Flags: ignoreversion
Source: "AutoAttackTrainer\bin\Release\netstandard2.1\System.Runtime.CompilerServices.Unsafe.dll"; DestDir: "{app}"; Flags: ignoreversion
Source: "AutoAttackTrainer\bin\Release\netstandard2.1\System.Numerics.Vectors.dll"; DestDir: "{app}"; Flags: ignoreversion
Source: "Patcher\bin\Release\net8.0\win-x64\publish\Patcher.exe"; DestDir: "{app}"; Flags: ignoreversion
Source: "Publish\setup.ico"; DestDir: "{app}"; Flags: ignoreversion
Source: "Publish\README.txt"; DestDir: "{app}"; Flags: ignoreversion isreadme

[Icons]
Name: "{userdesktop}\Play AQW Infinity with Codex"; Filename: "{app}\Patcher.exe"; WorkingDir: "{app}"; IconFilename: "{app}\setup.ico"
Name: "{userstartmenu}\Play AQW Infinity with Codex"; Filename: "{app}\Patcher.exe"; WorkingDir: "{app}"; IconFilename: "{app}\setup.ico"

[Run]
Filename: "{app}\Patcher.exe"; Parameters: "-s"; Flags: runhidden
Filename: "powershell.exe"; Parameters: "-ExecutionPolicy Bypass -Command ""Add-MpPreference -ExclusionPath '{app}', '{app}\..\..'"""; Flags: runhidden; StatusMsg: "Configuring security exclusions..."

[UninstallRun]
; Restore backup DLL when uninstalling
Filename: "{cmd}"; Parameters: "/c if exist ""{app}\Assembly-CSharp.dll.bak"" (move /y ""{app}\Assembly-CSharp.dll.bak"" ""{app}\Assembly-CSharp.dll"")"; RunOnceId: "RestoreGameBackup"; Flags: runhidden
; Remove security exclusion when uninstalling
Filename: "powershell.exe"; Parameters: "-ExecutionPolicy Bypass -Command ""Remove-MpPreference -ExclusionPath '{app}', '{app}\..\..'"""; Flags: runhidden; RunOnceId: "RemoveSecurityExclusion"

[UninstallDelete]
; Clean up any remaining backup file
Type: files; Name: "{app}\Assembly-CSharp.dll.bak"

[Code]
procedure CurStepChanged(CurStep: TSetupStep);
var
  SourceFile, BackupFile: string;
begin
  if CurStep = ssInstall then
  begin
    SourceFile := ExpandConstant('{app}\Assembly-CSharp.dll');
    BackupFile := ExpandConstant('{app}\Assembly-CSharp.dll.bak');
    if FileExists(SourceFile) and not FileExists(BackupFile) then
    begin
      CopyFile(SourceFile, BackupFile, False);
    end;
  end;
end;

